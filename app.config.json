{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Practice Mirror",
  "nameJa": "Practice Mirror",
  "slug": "practice-mirror",
  "version": "0.2.0",
  "description": "See your movement a few seconds later without stopping to record and replay.",
  "descriptionJa": "録画と再生を繰り返さず、数秒前の自分の動きをその場で確認する遅延ミラーです。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-practice-mirror"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
