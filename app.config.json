{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Practice Mirror",
  "nameJa": "Practice Mirror",
  "slug": "practice-mirror",
  "version": "0.6.0",
  "description": "Use a local delayed camera mirror with adaptive performance, frame review, guides, and explicit local clip saving.",
  "descriptionJa": "端末負荷に合わせて自動調整する遅延ミラーで動きを確認し、コマ送り・ガイド・必要なReview保存までブラウザ内で行えます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-practice-mirror"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 2,
      "selfExtractWarningMb": 1
    }
  }
}
