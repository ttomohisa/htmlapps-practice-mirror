{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Practice Mirror",
  "nameJa": "Practice Mirror",
  "slug": "practice-mirror",
  "version": "0.7.0",
  "description": "A local delayed practice mirror with Review, adaptive performance, bounded buffers, and recovery for long-running sessions.",
  "descriptionJa": "遅延表示・Review・自動負荷調整に加え、長時間利用向けのバッファ上限監視と限定自動復旧を備えた練習ミラーです。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-practice-mirror"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 2,
      "selfExtractWarningMb": 1
    }
  }
}
