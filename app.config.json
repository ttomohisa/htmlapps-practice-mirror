{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Practice Mirror",
  "nameJa": "Practice Mirror",
  "slug": "practice-mirror",
  "version": "0.3.0",
  "description": "See your movement a few seconds later, review it frame by frame, and overlay simple alignment guides without uploading video.",
  "descriptionJa": "数秒前の動きを遅延表示し、コマ送りとシンプルなガイド線でフォームを確認できるローカル処理の練習ミラーです。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-practice-mirror"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 2,
      "selfExtractWarningMb": 1
    }
  }
}
