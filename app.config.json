{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Practice Mirror",
  "nameJa": "Practice Mirror",
  "slug": "practice-mirror",
  "version": "0.5.0",
  "description": "Use a 1–30 second delayed camera mirror, review movement frame by frame, and save only the clips you need locally.",
  "descriptionJa": "1〜30秒の遅延ミラーで動きを確認し、コマ送りやガイドで見返して、必要なReviewだけ端末へ保存できます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-practice-mirror"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 2,
      "selfExtractWarningMb": 1
    }
  }
}
